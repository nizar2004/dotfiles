{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "CachyOS_old_small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "bright_green",
      "2": "cyan"
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "bright_green",
      "title": "bright_cyan"
    },
    "key": {
      "width": 24
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "Welcome, Nizar!",
      "color": "bright_green"
    },
    { "type": "separator", "string": "━━━━━━━━━━━━━━━━━━━━━━━━" },

    { "type": "os", "key": "󰣇 System        ", "keyColor": "bright_cyan" },
    { "type": "kernel", "key": "󰌽 Kernel        ", "keyColor": "bright_cyan" },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "bright_cyan"
    },
    { "type": "shell", "key": "󰞷 Shell         ", "keyColor": "bright_cyan" },
    { "type": "de", "key": "󱂬 Desktop       ", "keyColor": "bright_cyan" },
    { "type": "wm", "key": "󱂬 Window Manager", "keyColor": "bright_cyan" },
    { "type": "terminal", "key": "󰆍 Terminal      ", "keyColor": "bright_cyan" },

    "break",
    { "type": "cpu", "key": "󰻠 CPU           ", "keyColor": "bright_yellow" },
    { "type": "gpu", "key": "󰢮 GPU 1         ", "format": "{2}", "hideType": "integrated", "keyColor": "bright_yellow" },
    { "type": "gpu", "key": "󰢮 GPU 2         ", "format": "{2}", "hideType": "discrete", "keyColor": "bright_yellow" },
    { "type": "memory", "key": "󰍛 Memory        ", "keyColor": "bright_yellow" },

    "break",
    { "type": "uptime", "key": "󱎫 Uptime        ", "keyColor": "bright_magenta" },
    {
      "type": "command",
      "key": "󰔟 OS Age        ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); age=$(( (current - birth_install) / 86400 )); echo \"$age days\"",
      "keyColor": "bright_magenta"
    },
    { "type": "datetime", "key": "󰃭 Time          ", "keyColor": "bright_magenta" },

    "break",
    { "type": "colors", "paddingLeft": 2 }
  ]
}
